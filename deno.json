{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "imports": {
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "react/jsx-runtime": "npm:react@^19.0.0/jsx-runtime",
    "react/jsx-dev-runtime": "npm:react@^19.0.0/jsx-dev-runtime",
    "react-dom/client": "npm:react-dom@^19.0.0/client",
    "@formspree/react": "npm:@formspree/react@^2.0.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.0.0",
    "vite": "npm:vite@^6.0.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "esnext"]
  }
}
